   "outputs": [],
   "source": [
    "#list counties with the greatest risks\n",
    "table_base = alt.Chart(nri_clean).transform_window(\n",
    "    row_number = 'row_number()',\n",
    "    sort = [alt.SortField('MAX_VAL', order = 'descending')]\n",
    ").transform_filter(\n",
    "    alt.datum.row_number <=20\n",
    ").mark_text(baseline='middle').encode(\n",
    "    y = alt.Y('row_number:O', axis = None),\n",
    ")\n",
    "\n",
    "state_col = table_base.mark_text(align = 'left',  dx=-25, fontSize=16).encode(\n",
    "    text = alt.Text(\"STATE:N\")\n",
    ").properties(title = alt.TitleParams('State',fontSize=20), width = 200)\n",
    "\n",
    "county_col = table_base.mark_text(align = 'left',  dx=-33, fontSize=16).encode(\n",
    "    text = \"COUNTY:N\"\n",
    ").properties(title = alt.TitleParams('County',fontSize=20), width = 200)\n",
    "\n",
    "hazard_col = table_base.mark_text(align = 'left', dx = -75, fontSize=16).encode(\n",
    "    text = \"MAX_COL:N\"\n",
    ").properties(title = alt.TitleParams('Greatest Hazard',fontSize=20), width = 200)\n",
    "\n",
    "score_col = table_base.mark_text(align = 'right', dx = 108, fontSize=16).encode(\n",
    "    text = alt.Text(\"MAX_VAL:Q\",format = ',.2f')\n",
    ").properties(title = alt.TitleParams('Greatest Hazard Score',fontSize=20), width = 200)\n",
    "\n",
    "pop_col = table_base.mark_text(align = 'right', dx = 55, fontSize=16).encode(\n",
    "    text = alt.Text(\"POPULATION:Q\",format = ',.0f')\n",
    ").properties(title = alt.TitleParams('Population',fontSize=20), width = 200)\n",
    "\n",
    "eals_col = table_base.mark_text(align = 'right', dx = 130, fontSize=16).encode(\n",
    "    text = alt.Text(\"MAX_EALS:Q\",format = ',.2f')\n",
    ").properties(title = alt.TitleParams('Greatest Hazard EAL Score',fontSize=20), width = 200)\n",
    "\n",
    "sovi_col = table_base.mark_text(align = 'right', dx = 120, fontSize=16).encode(\n",
    "    text = alt.Text(\"SOVI_SCORE:Q\",format = ',.2f')\n",
    ").properties(title = alt.TitleParams('Social Vulnerability Score',fontSize=20), width = 200)\n",
    "\n",
    "resl_col = table_base.mark_text(align = 'right', dx = 130, fontSize=16).encode(\n",
    "    text = alt.Text(\"RESL_SCORE:Q\",format = ',.2f')\n",
    ").properties(title = alt.TitleParams('Community Resilience Score',fontSize=20), width = 200)\n",
    "\n",
    "\n",
    "\n",
    "country_risk_table = alt.hconcat(state_col,county_col,pop_col,hazard_col,score_col,eals_col,sovi_col, resl_col)\n",
    "country_risk_table.properties(title = alt.TitleParams('Top 20 Counties at Risk', anchor = 'middle', fontSize = 24, offset = 20)).configure_view(stroke = None)\n"
   ]
