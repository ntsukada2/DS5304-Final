    "    as_ = ['column', 'value']\n",
    ").encode(\n",
    "    size = alt.Size(\n",
    "            'POPULATION:Q',\n",
    "            title = 'Population',\n",
    "            scale = alt.Scale(\n",
    "                domain = [0,600000],\n",
    "                range = [50,400]\n",
    "            ),\n",
    "            legend = alt.Legend(titleFontSize = 14, labelFontSize= 12, orient = 'none', legendX = 1150,)\n",
    "        ),\n",
    "    tooltip=[alt.Tooltip('COUNTY:N', title = 'County'), alt.Tooltip('POPULATION:Q', title = 'Population', format = \",.0f\"), alt.Tooltip(\"RISK_SCORE:Q\", title = 'Selected Hazard Risk Score', format = \".2f\")],\n",
    "    color = alt.condition(social_commr_select, \n",
