   "source": [
    "#illustrate greatest hazard per county across the US\n",
    "counties = alt.topo_feature(data.us_10m.url, 'counties')\n",
    "\n",
    "hazard_color_scale = alt.Scale(\n",
    "    domain = risk_usrfriend,\n",
    "    range = ['#A9D6E5', '#0077B6', '#4CC9F0', '#C2A878', '#6F4E37', '#BDE0FE', '#FF6B00', '#006D77', '#90E0EF', '#A44A3F', '#FFD60A', '#1D4ED8','#7B9EA8', '#4A4E69', '#023E8A', '#D62828', '#E85D04', '#CDB4DB' ]\n",
    ")\n",
    "country_max_nri = alt.Chart(nri_clean).mark_geoshape().encode(\n",
    "    shape = 'geo:G',\n",
    "    color= alt.Color('MAX_COL:N', \n",
    "                     title = 'Greatest Hazard',\n",
    "                     scale = hazard_color_scale,\n",
    "                     legend = alt.Legend(orient = 'left',titleFontSize = 14, labelFontSize= 12, labelPadding = 50, titlePadding = 10)),\n",
    "    tooltip=[alt.Tooltip('STATE:N', title = 'State'),\n",
    "             alt.Tooltip('COUNTY:N', title = 'County'), \n",
    "             alt.Tooltip('POPULATION:Q', title = 'Population', format= ',.0f'),\n",
    "             alt.Tooltip('MAX_COL', title = 'Greatest Risk'), \n",
    "             alt.Tooltip(\"MAX_VAL:Q\", title = 'Greatest Hazard Risk Score', format = \".2f\"), \n",
    "             alt.Tooltip(\"MAX_EALS:Q\", title = 'Greatest Hazard EAL Score', format = '.2f'),\n",
    "             alt.Tooltip(\"SOVI_SCORE:Q\", title = 'Social Vulnerability Score', format = \".2f\"), \n",
    "             alt.Tooltip(\"RESL_SCORE:Q\", title = 'Community Resilience Score', format = \".2f\")],\n",
    "    stroke = alt.value('white')\n",
    ").transform_lookup(\n",
    "    lookup='STCOFIPS',\n",
    "    from_ = alt.LookupData(data = counties, key = 'id'),\n",
    "    as_ = 'geo'\n",
    ").project(\n",
    "    \"albersUsa\"\n",
    ").properties(\n",
    "    height = 600,\n",
    "    width = 900, \n",
    "    title = alt.TitleParams('Greatest Hazards by County in the US',anchor = 'middle', fontSize = 24, offset = 10),\n",
    "\n",
    "    \n",
    ")\n",
    "\n",
    "country_max_nri\n"
   ]
