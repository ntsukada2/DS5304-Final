   "source": [
    "##Import altair, necessary libraries for topography, and pandas\n",
    "import altair as alt\n",
    "from vega_datasets import data \n",
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9c7ea8b4",
   "metadata": {},
   "source": [
    "<div>\n",
    "    <h1 style = \"font-size: 2.25rem; font-family: sans-serif;  font-weight: bold\">Introduction</h1>\n",
    "    <p>The FEMA National Risk Index (NRI) dataset evaluates natural hazard risks to communities across the United States. The hazards covered by the dataset are avalanche, coastal flooding, cold wave, drought, earthquake, hail, heat wave, hurricane, ice storm, inland flooding, landslide, lightning, strong wind, tornado, tsunami, volcanic activity, wildfire, and winter weather. This information is used by public agencies, private organizations, and members of academia for risk awareness, communication, emergency preparedness, and mitigation planning.\n",
    "    </p>\n",
    "    <p> Risk scores are provided per county and per individual hazard. Scores are determined by three individual components: Expected Annual Loss, Social Vulnerability, and Community Resilience. </p>\n",
    "    <ul>\n",
    "        <li>Expected Annual Loss (EAL): the expected monetary value lost due to natural hazards per year</li>\n",
    "        <li>Social Vulnerability: the susceptibility of a community to the impacts of natural hazards</li>\n",
    "        <li>Community Resilience: the ability a community has to prepare and recover from the impacts of natural hazards. </li>\n",
    "    </ul>\n",
    "    <p>Below is the equation used to calculate risk scores: </p>\n",
    "    <div>\n",
    "        <math>\n",
    "            <mn>Risk Index Score = </mn>\n",
    "            <mfrac>\n",
    "                <mn>Expected Annual Loss x Social Vulnerability</mn>\n",
    "                <mn> Community Resilience </mn>\n",
    "            </mfrac>\n",
    "        </math>\n",
    "    </div>\n",
    "    <p>Counties with high expected annual losses, high social vulnerability, and lower community resilience tend to receive higher NRI risk scores. </p>\n",
    "</div>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "4583ca12",
   "metadata": {},
   "outputs": [],
   "source": [
    "##import relevant columns from National Risk index dataset\n",
    "risk_scores  =['AVLN_RISKS', 'CFLD_RISKS', 'CWAV_RISKS', 'DRGT_RISKS', 'ERQK_RISKS', 'HAIL_RISKS', 'HWAV_RISKS', 'HRCN_RISKS', 'ISTM_RISKS', 'LNDS_RISKS', 'LTNG_RISKS', 'IFLD_RISKS', 'SWND_RISKS', 'TRND_RISKS', 'TSUN_RISKS', 'VLCN_RISKS', 'WFIR_RISKS', 'WNTW_RISKS',]\n",
    "risk_usrfriend = ['Avalanche', 'Coastal Flooding', 'Cold Wave', 'Drought', 'Earthquake', 'Hail', 'Heat Wave', 'Hurricane', 'Ice Storm', 'Landslide', 'Lightning', 'Inland Flooding', 'Strong Wind', 'Tornado', 'Tsunami', 'Volcanic Activity', 'Wildfire', 'Winter Weather',]\n",
    "risk_ratings = ['AVLN_RISKR', 'CFLD_RISKR', 'CWAV_RISKR', 'DRGT_RISKR', 'ERQK_RISKR', 'HAIL_RISKR', 'HWAV_RISKR', 'HRCN_RISKR', 'ISTM_RISKR', 'LNDS_RISKR', 'LTNG_RISKR', 'IFLD_RISKR', 'SWND_RISKR', 'TRND_RISKR', 'TSUN_RISKR', 'VLCN_RISKR', 'WFIR_RISKR', 'WNTW_RISKR',]\n",
    "area_info = ['STATE','COUNTY','STATEFIPS','STCOFIPS','POPULATION','EAL_SCORE', 'RISK_SCORE','RISK_RATNG','SOVI_SCORE','RESL_SCORE']\n",
    "risk_eals = ['AVLN_EALS', 'CFLD_EALS', 'CWAV_EALS', 'DRGT_EALS', 'ERQK_EALS', 'HAIL_EALS', 'HWAV_EALS', 'HRCN_EALS', 'ISTM_EALS', 'LNDS_EALS', 'LTNG_EALS', 'IFLD_EALS', 'SWND_EALS', 'TRND_EALS', 'TSUN_EALS', 'VLCN_EALS', 'WFIR_EALS', 'WNTW_EALS']\n",
    "risk_cols = risk_scores + risk_ratings + area_info + risk_eals\n",
    "\n",
    "nri_raw = pd.read_csv(\"./Sorted_NRI_Table_Counties.csv\", usecols = risk_cols)\n",
    "\n",
    "##Clean any empty score columns by filling with zeroes\n",
    "nri_clean = nri_raw.fillna(0)\n",
    "\n",
    "##find greatest hazard per county\n",
    "nri_clean['MAX_COL'] = nri_clean[risk_scores].idxmax(axis = 1)\n",
    "\n",
    "\n",
    "\n",
    "#Grab corresponding EALS score for individual greatest hazards\n",
    "nri_clean['MAX_EALS'] = nri_clean.apply(lambda x: x[f\"{x[\'MAX_COL\'][:-6]}_EALS\"], axis = 1)\n",
    "\n",
    "#map values to user friendly names\n",
    "nri_clean['MAX_COL'] = nri_clean['MAX_COL'].replace({'AVLN_RISKS':'Avalanche', 'CFLD_RISKS':'Coastal Flooding', 'CWAV_RISKS':'Cold Wave', 'DRGT_RISKS':'Drought', 'ERQK_RISKS':'Earthquake', 'HAIL_RISKS':'Hail', 'HWAV_RISKS':'Heat Wave', 'HRCN_RISKS':'Hurricane', 'ISTM_RISKS':'Ice Storm', 'LNDS_RISKS':'Landslide', 'LTNG_RISKS':'Lightning', 'IFLD_RISKS':'Inland Flooding', 'SWND_RISKS':'Strong Wind', 'TRND_RISKS':'Tornado', 'TSUN_RISKS':'Tsunami', 'VLCN_RISKS':'Volcanic Activity', 'WFIR_RISKS':'Wildfire', 'WNTW_RISKS':'Winter Weather'})\n",
    "nri_clean['MAX_VAL'] = nri_clean[risk_scores].max(axis = 1)\n",
    "\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "59142b94",
   "metadata": {},
   "outputs": [],
   "source": [
    "#get country level metrics\n",
    "total_counties = len(nri_clean)\n",
    "most_common_risk = nri_clean['MAX_COL'].value_counts().index[0]\n",
    "num_counties_affected = nri_clean['MAX_COL'].value_counts().iloc[0]\n",
    "population_groups = nri_clean.groupby([\"MAX_COL\"]).sum()['POPULATION']\n",
    "largest_pop_risk = nri_clean.groupby([\"MAX_COL\"]).sum()['POPULATION'].idxmax()\n",
    "largest_pop_amount = nri_clean.groupby([\"MAX_COL\"]).sum()['POPULATION'].max()\n",
    "\n"
   ]
  },
