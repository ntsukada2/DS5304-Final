    "    as_ = ['column', 'value']\n",
    ").mark_geoshape().encode(\n",
    "    shape = 'geo:G',\n",
    "    stroke = alt.value('white'),\n",
    "    color= alt.condition(social_commr_select,alt.Color('value:Q', \n",
    "                        \n",
    "                        scale = alt.Scale(\n",
    "                            domain = [0, 60, 100],\n",
    "                            range=['#1a9641', '#FFD60A', '#d7191c']\n",
    "                        )),alt.value(\"lightgray\")),\n",
    "    tooltip=[alt.Tooltip('COUNTY:N', title = 'County'), alt.Tooltip('POPULATION:Q', title = 'Population', format=',.0f'),alt.Tooltip('value:Q', title = 'Hazard Score', format = '.2f')]\n",
    ").transform_lookup(\n",
